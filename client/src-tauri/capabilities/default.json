{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desk overlay and independent panel: events, panel window controls and copying text.",
  "windows": [
    "main",
    "panel"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "clipboard-manager:allow-write-text"
  ]
}
