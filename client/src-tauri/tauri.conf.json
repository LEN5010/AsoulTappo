{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AsoulTappo",
  "version": "0.1.0-beta.4",
  "identifier": "io.github.len5010.asoultappo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AsoulTappo",
        "width": 960,
        "height": 640,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "GPL-2.0-only",
    "copyright": "AsoulTappo contributors; derived from Evelynall/ASoul-Little-Bun (GPL-2.0)"
  }
}
