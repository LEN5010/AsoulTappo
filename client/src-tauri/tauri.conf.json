{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AsoulTappo",
  "version": "1.1.4",
  "identifier": "io.github.len5010.asoultappo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AsoulTappo",
        "width": 960,
        "height": 640,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "GPL-2.0-only",
    "copyright": "Copyright © 2026 AsoulTappo contributors. Character artwork © A-SOUL.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3RTlDODM3ODM4OEE2ODcKUldTSHBvaUROOGpwRjQ0cXVyTWhmV2RYOWs0WG8yWXdHSHFMSW5TSWhhNzFjNGpINEdOekJEcjcK",
      "endpoints": [
        "https://github.com/LEN5010/AsoulTappo/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
